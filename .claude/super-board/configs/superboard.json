{
  "version": 1,
  "description": "super-board pack — fixes shipped through its own board",
  "project": {
    "owner": "Ledmetal94",
    "title": "Superboard",
    "number": 1
  },
  "worker_backend": "workflow",
  "host": "claude",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/Ledmetal94/super-board"
  },
  "base_branch": "main",
  "timezone": "Europe/Rome",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "allowed_envs": [],
    "target_env": "live",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_workers": 0,
  "rebuild_cap": 2,
  "verify_commands": [
    "bash tests/run-safety.sh"
  ],
  "collect": {
    "sources": [
      "github",
      "prs",
      "architecture"
    ],
    "window_days": 14,
    "prs": {
      "max_prs": 200
    },
    "architecture": {
      "max_findings": 5
    },
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "Ledmetal94"
  }
}
